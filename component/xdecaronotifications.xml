<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>COM_XDECARONOTIFICATIONS</name>
  <author>Luca De Caro</author>
  <creationDate>2026-09</creationDate>
  <copyright>Copyright (C) 2026 Luca De Caro. All rights reserved.</copyright>
  <license>GNU General Public License version 2 or later</license>
  <authorUrl>https://github.com/xdecaro/notifications</authorUrl>
  <version>1.0.2</version>
  <description>COM_XDECARONOTIFICATIONS_XML_DESCRIPTION</description>
  <namespace path="src">Xdecaro\Component\Notifications</namespace>

  <administration>
    <menu view="dashboard">COM_XDECARONOTIFICATIONS</menu>
    <submenu>
      <menu view="dashboard">COM_XDECARONOTIFICATIONS_DASHBOARD</menu>
      <menu view="notifications">COM_XDECARONOTIFICATIONS_NOTIFICATIONS</menu>
      <menu view="deliveries">COM_XDECARONOTIFICATIONS_DELIVERIES</menu>
      <menu view="preferences">COM_XDECARONOTIFICATIONS_PREFERENCES</menu>
      <menu view="information">COM_XDECARONOTIFICATIONS_INFORMATION</menu>
    </submenu>
    <files folder="admin">
      <filename>access.xml</filename>
      <filename>config.xml</filename>
      <folder>language</folder>
      <folder>services</folder>
      <folder>sql</folder>
      <folder>src</folder>
      <folder>tmpl</folder>
    </files>
  </administration>

  <install>
    <sql>
      <file driver="mysql" charset="utf8">sql/install.mysql.utf8mb4.sql</file>
    </sql>
  </install>

  <update>
    <schemas>
      <schemapath type="mysql">sql/updates/mysql</schemapath>
    </schemas>
  </update>
